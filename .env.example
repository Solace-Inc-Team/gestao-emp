# Produção (Coolify): string de conexão do Postgres.
# Em desenvolvimento, `npm run dev` sobe um Postgres local e define esta variável sozinho.
DATABASE_URL=

# endereço público do site, usado nas prévias de link (WhatsApp, redes). Ex.: https://app.meudominio.com.br
APP_URL=

# true = cria a empresa fictícia "Distribuidora Fonte Azul" se o banco estiver vazio
SEED_DEMO=true

# equipe da Solace (acessa /admin). Criado no primeiro start se ainda não existir.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# alertas de erro no Telegram (opcional). Veja a seção Monitoramento do DEPLOY.md
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=

# cofre dos tokens de terceiros guardados no banco (Mercado Pago de cada empresa). 32 bytes em base64:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Guarde junto com o backup: sem ela, os tokens salvos não abrem e cada empresa precisa conectar de novo.
SEGREDO_CHAVE=
